# Read by manga-image-translator (the upstream project), not by this repo.
# Local Ollama through its OpenAI-compatible endpoint. No real key is needed.
CUSTOM_OPENAI_API_BASE=http://localhost:11434/v1
CUSTOM_OPENAI_MODEL=aya-expanse:32b
CUSTOM_OPENAI_API_KEY=ollama

# Read by server/mt_ui.py
# MT_CACHE_MAX_GB=10
# MT_OUT_ROOT=~/Downloads/mt-ui-out
# MT_GPT_CONFIG=~/.config/mt-stack/gpt_config.yaml
