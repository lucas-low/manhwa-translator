<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lucaslow.mt-translator</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/lucaslow/manga-image-translator/venv/bin/python</string>
        <string>/Users/lucaslow/manga-image-translator/server/main.py</string>
        <string>--use-gpu</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
        <string>--nonce</string>
        <string>None</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/lucaslow/manga-image-translator</string>
    <key>RunAtLoad</key>
    <true/>
