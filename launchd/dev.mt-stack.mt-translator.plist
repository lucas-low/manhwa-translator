<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.mt-stack.mt-translator</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MT_HOME__/venv/bin/python</string>
        <string>__MT_HOME__/server/main.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__MT_HOME__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/mt-translator.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mt-translator.log</string>
</dict>
</plist>
